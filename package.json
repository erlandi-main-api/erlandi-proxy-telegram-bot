{
  "name": "erlandi-proxy-telegram-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Secure inline-menu control bot for Erlandi Proxy",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc",
    "start": "node dist/src/index.js",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "node node_modules/typescript/bin/tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "grammy": "^1.45.1",
    "pino": "^10.3.1",
    "sql.js": "^1.14.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/sql.js": "^1.4.11",
    "typescript": "^5.9.3"
  }
}
